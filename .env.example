# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google 試算表後端（Apps Script 網頁應用程式網址）
# 部署步驟見 google-apps-script/Code.gs 檔頭說明
# 若複製到學校網域格式：
#   https://script.google.com/a/macros/你的學校.edu.tw/s/XXXX/exec
# 前端會自動轉成公開格式：
#   https://script.google.com/macros/s/XXXX/exec
# 未設定時改走本機 mock + localStorage
VITE_SHEETS_API_URL="https://script.google.com/macros/s/XXXX/exec"

# 設為 true 才開放「一鍵切換身分／測試帳號填入」（正式站請保持關閉或不設）
VITE_DEMO_MODE="false"

# 處室登入密碼（可選；未設則使用程式內預設）
# VITE_ADMIN_ACADEMIC_PASS="CcvsAcad113"
# VITE_ADMIN_STUDENT_PASS="CcvsStu113"
# VITE_ADMIN_SYSTEM_PASS="CcvsAdmin113"
